# =============================================================================
# Media 8 | Workstation - Environment Configuration (.env.example)
# =============================================================================

# ============================================
# BANCO DE DADOS (PostgreSQL Externo / Servidor de Banco)
# ============================================
# Host do servidor PostgreSQL (ex: IP da rede local 192.168.18.110, localhost ou host.docker.internal)
DB_HOST=192.168.18.110

# Porta do PostgreSQL
DB_PORT=5432

# Nome do banco de dados
DB_NAME=media8_workstation_db

# Usuario do banco de dados
DB_USERNAME=media8_user

# Senha do banco de dados (Mudar em producao!)
DB_PASSWORD=media8_password_secret

# String de conexao completa montada dinamicamente
DB_CONNECTION_STRING=Host=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USERNAME};Password=${DB_PASSWORD}

# ============================================
# ADMINISTRADOR INICIAL (Seeding automático se não houver Admin)
# ============================================
INITIAL_ADMIN_EMAIL=admin@media8.com
INITIAL_ADMIN_PASSWORD=SenhaAdminSegura123!

# ============================================
# SEGURANÇA, JWT AUTHENTICATION & CORS
# ============================================
JWT_SECRET_KEY=S3cur3S3cr3tKeyM3dia8Workstati0n2026!Min32Chars
JWT_ISSUER=Media8Workstation
JWT_AUDIENCE=Media8WorkstationUsers

# Define se a restrição de origem deve ser ligada (true) ou se a API fica aberta para qualquer origem (false)
CORS_RESTRICTED=false

# Origens (domínios) permitidos quando CORS_RESTRICTED=true (separe por vírgula para múltiplos domínios)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://pc.havenox.dev

# ============================================
# API SERVER (.NET 10)
# ============================================
API_PORT=5000
ASPNETCORE_ENVIRONMENT=Development

# ============================================
# WEB FRONTEND (React SPA)
# ============================================
WEB_PORT=3000
VITE_API_URL=http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000

# ============================================
# WORKER STORAGE
# ============================================
# Arquivos são agrupados por Order ID: /storage/{orderId}/raw, /storage/{orderId}/proxies, etc.
STORAGE_BASE_PATH=/storage
