FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG WORKER_PROJECT=Media8.Workstation.Worker.Ingestion
WORKDIR /app

COPY media8-api/src/Media8.Workstation.Domain/Media8.Workstation.Domain.csproj media8-api/src/Media8.Workstation.Domain/
COPY media8-api/src/Media8.Workstation.Infrastructure/Media8.Workstation.Infrastructure.csproj media8-api/src/Media8.Workstation.Infrastructure/
COPY media8-workers/${WORKER_PROJECT}/${WORKER_PROJECT}.csproj media8-workers/${WORKER_PROJECT}/

RUN dotnet restore media8-workers/${WORKER_PROJECT}/${WORKER_PROJECT}.csproj

COPY . ./
RUN dotnet publish media8-workers/${WORKER_PROJECT}/${WORKER_PROJECT}.csproj -c Release -o /app/out

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
ARG WORKER_PROJECT=Media8.Workstation.Worker.Ingestion
ENV WORKER_DLL=${WORKER_PROJECT}.dll

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg poppler-utils && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /app/out .

ENTRYPOINT ["sh", "-c", "exec dotnet $WORKER_DLL"]
